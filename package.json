{
  "name": "proyecto_identificacion_imagenes",
  "version": "1.0.0",
  "description": "Monolito para etiquetado y anotación de imágenes con soporte de exportación en formato COCO.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "start": "node dist/server.js",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JGO-07/Proyecto_Identificacion_imagenes.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JGO-07/Proyecto_Identificacion_imagenes/issues"
  },
  "homepage": "https://github.com/JGO-07/Proyecto_Identificacion_imagenes#readme",
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.4.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^7.1.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "minio": "^8.0.7",
    "mysql2": "^3.24.2",
    "konva": "^9.3.22",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.0.10",
    "react-router-dom": "^7.8.2",
    "zustand": "^5.0.8",
    "zod": "^4.0.0"
  }
}
